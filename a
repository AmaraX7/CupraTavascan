<!DOCTYPE html>
<script src="scripts.js"></script>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mi Web Cupra Tavascan</title>
    <link rel="stylesheet" href="styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <div class="header-content">
            <h1>Know your Cupra Tavascan</h1>
            <a href="https://www.cupraofficial.es/" target="_blank">
                <img src="https://upload.wikimedia.org/wikipedia/commons/0/09/Cupra_White.png" alt="Logo Cupra" class="logo">
            </a>
        </div>
    </header>


    <nav class="tab-bar">
        <button onclick="cambiarPestaña('inicio')">Home</button>
        <button onclick="cambiarPestaña('uno')">Interior</button>
        <button onclick="cambiarPestaña('dos')">Videos</button>
        <div id="tab-title" style="display: none;">Welcome to Cupra Tavascan Experience</div>
    </nav>

      <div id="pestaña-inicio" class="pestaña activa" style="display: block;">
        
        <section id="countdown">
            <h2>Countdown for car arrival:</h2>
            <p id="timer"></p>
        </section>
    </div>
      
      <div id="pestaña-uno" class="pestaña">
        <h3 id= "Overview">Overview (left hand drive)</h3>
            
            <section>
                <div class="image-container">
                    <img src="images/parteFrontal.jpg" alt="Parte Frontal" class="dashboard-image">
                    
                    <!-- Botones flotantes -->
                    <button class="hotspot" style="top: 1.6%; left: 11.7%;" onclick="showInfo(1)">1</button>
                    <button class="hotspot" style="top: 1.6%; left: 15.5%;" onclick="showInfo(2)">2</button>
                    <button class="hotspot" style="top: 1.6%; left: 19.5%;" onclick="showInfo(3)">3</button>
                    <button class="hotspot" style="top: 1.6%; left: 28.5%;" onclick="showInfo(4)">4</button>
                    <button class="hotspot" style="top: 1.6%; left: 32.5%;" onclick="showInfo(5)">5</button>
                    <button class="hotspot" style="top: 1.6%; left: 38.4%;" onclick="showInfo(6)">6</button>
                    <button class="hotspot" style="top: 1.6%; left: 43%;" onclick="showInfo(5)">5</button>
                    <button class="hotspot" style="top: 1.6%; left: 47%;" onclick="showInfo(7)">7</button>
                    <button class="hotspot" style="top: 1.6%; left: 63.7%;" onclick="showInfo(8)">8</button>
                    <button class="hotspot" style="top: 89.7%; left: 17.6%;" onclick="showInfo(9)">9</button>
                    <button class="hotspot" style="top: 89.7%; left: 28%;" onclick="showInfo(10)">10</button>
                    <button class="hotspot" style="top: 89.7%; left: 33%;" onclick="showInfo(11)">11</button>
                    <button class="hotspot" style="top: 89.7%; left: 40%;" onclick="showInfo(12)">12</button>
                    <button class="hotspot" style="top: 89.7%; left: 67.5%;" onclick="showInfo(13)">13</button>
                </div>
                
                <div id="info-box" class="info-box">
                    Click on a number to see more information.
                </div>        
            </section>
            
        </h3>
      </div>
      
      <div id="pestaña-dos" class="pestaña" style="display: none;">
    
        <!-- Carrusel de Videos -->
        <section id="video-carousel">
            <p id="video-description">Sistema de Aparcamiento en Línea</p>
            <div class="carousel">
                <button class="prev" onclick="moveCarousel(-1)">❮</button>
                <div class="carousel-videos">
                    <iframe id="current-video" src="https://www.youtube.com/embed/Sdj9iO8opuU" frameborder="0" allowfullscreen></iframe>
                </div>
                <button class="next" onclick="moveCarousel(1)">❯</button>
            </div>
        </section>
    </div>
      
      

    <!-- Chatbot -->
    <div id="chatbot-container">
        <div class="chat-header">
            <h3>Chatbot Cupra Tavascan</h3>
            <button id="toggle-chat">Abrir/Cerrar</button>
        </div>
        <div id="chat-body" class="chat-body">
            <div id="messages" class="messages"></div>
            <div class="chat-input">
                <input type="text" id="user-input" placeholder="Escribe tu pregunta...">
                <button id="send-btn">Enviar</button>
            </div>
        </div>
    </div>

    <script src="scripts.js"></script>
</body>
</html>